---
import Layout from '~/layouts/Layout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { Icon } from 'astro-icon/components';
import { PRESETS, SYARAT, TIPOGRAFI, FAQS, BLOK_LABEL } from '../data/presets.js';

const metadata = {
  title: 'InfografisCepat — Dapur Naskah Lomba Infografis',
  description:
    'Racik draf 6 blok naskah infografis dari 12 tema siap pakai, checklist syarat administratif lomba, dan panduan tipografi juri. Gratis, tanpa akun.',
  ignoreTitleTemplate: true,
};

const faqItems = FAQS.map((f) => ({ title: f.q, description: f.a }));
---

<Layout metadata={metadata}>
  <a
    href="#konten"
    style="min-width:44px;min-height:44px" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-[var(--pop)] focus:px-4 focus:py-2 focus:text-[var(--ink)]"
  >
    Lompat ke konten
  </a>

  <!-- ============ HEADER ============ -->
  <header class="sticky top-0 z-50 border-b-[3px] border-[var(--ink)] bg-[var(--bg)]">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
      <a href="#top" class="flex min-h-[44px] items-center gap-3" aria-label="InfografisCepat — kembali ke atas">
        <svg width="34" height="34" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
          <rect width="16" height="16" fill="#2b2bd9"></rect>
          <rect x="1" y="1" width="14" height="14" fill="#e8a04c"></rect>
          <rect x="2" y="2" width="12" height="5" fill="#f4e3c2"></rect>
          <rect x="3" y="7" width="10" height="1" fill="#2b2bd9"></rect>
          <rect x="4" y="9" width="2" height="2" fill="#1a1a1a"></rect>
          <rect x="10" y="9" width="2" height="2" fill="#1a1a1a"></rect>
          <rect x="6" y="12" width="4" height="2" fill="#1a1a1a"></rect>
        </svg>
        <span class="[font-family:var(--font-accent)] text-[1rem] leading-none">INFOGRAFIS<br />CEPAT</span>
      </a>
      <nav aria-label="Navigasi utama" class="ml-2 hidden items-center gap-5 md:flex">
        <a class="navlink" href="#racik">Racik</a>
        <a class="navlink" href="#jalur">Jalur Saji</a>
        <a class="navlink" href="#syarat">Syarat</a>
        <a class="navlink" href="#ekspor">Ekspor</a>
        <a class="navlink" href="#faq">FAQ</a>
      </nav>
      <div class="ml-auto flex items-center gap-3">
        <button
          id="motion-toggle"
          type="button"
          aria-pressed="true"
          class="inline-flex min-h-[44px] items-center border-2 border-[var(--ink)] bg-[var(--cream)] px-3 py-2 text-[1rem] leading-none transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0"
        >
          Gerak: <span id="motion-state">Nyala</span>
        </button>
        <a
          href="#racik"
          class="inline-flex min-h-[44px] items-center border-2 border-[var(--ink)] bg-[var(--blue)] px-4 py-2 text-[1rem] font-bold leading-none text-[var(--ink)] shadow-[4px_4px_0_var(--ink)] transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0 active:shadow-none"
        >
          Mulai Meracik
        </a>
      </div>
    </div>
    <nav aria-label="Navigasi seluler" class="flex gap-5 overflow-x-auto border-t-2 border-[var(--ink)] px-4 py-2 md:hidden">
      <a class="navlink whitespace-nowrap" href="#racik">Racik</a>
      <a class="navlink whitespace-nowrap" href="#jalur">Jalur Saji</a>
      <a class="navlink whitespace-nowrap" href="#syarat">Syarat</a>
      <a class="navlink whitespace-nowrap" href="#ekspor">Ekspor</a>
      <a class="navlink whitespace-nowrap" href="#faq">FAQ</a>
    </nav>
  </header>

  <main id="konten">
    <!-- ============ HERO ============ -->
    <section id="top" aria-label="Pembuka" class="relative overflow-hidden border-b-[3px] border-[var(--ink)]">
      <div id="hero-pin" class="flex min-h-[92dvh] flex-col justify-between">
        <div class="marquee-band border-b-[3px] border-[var(--ink)] bg-[var(--ink)] text-[var(--bg)]" aria-hidden="true">
          <div class="marquee-track" data-dir="1">
            <span>RACIK NASKAH &#10033; CEK SYARAT &#10033; GANTI ANGKA CONTOH &#10033; KIRIM H-1 &#10033;&nbsp;</span>
            <span>RACIK NASKAH &#10033; CEK SYARAT &#10033; GANTI ANGKA CONTOH &#10033; KIRIM H-1 &#10033;&nbsp;</span>
          </div>
        </div>

        <div id="hero-inner" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10">
          <p class="mb-6 inline-block border-2 border-[var(--ink)] bg-[var(--pop)] px-3 py-1 [font-family:var(--font-accent)] text-[1rem]">
            DAPUR NASKAH &middot; LOMBA INFOGRAFIS
          </p>
          <h1 id="hero-title" class="[font-family:var(--font-display)] leading-[0.95] tracking-tight" aria-label="Infografis Cepat">
            <span class="hero-word inline-block">INFOGRAFIS</span><br />
            <span class="hero-word inline-block text-[var(--blue-deep)]">CEPAT</span>
          </h1>
          <p class="mt-8 max-w-[62ch]">
            Peserta lomba infografis sering gugur bukan karena desainnya jelek &mdash; tapi karena naskahnya
            berantakan dan syarat administratifnya bolong. Di dapur ini kamu meracik draf 6 blok naskah
            dari 12 tema siap pakai, mencentang syarat juri satu per satu, lalu membungkus semuanya
            untuk diekspor. Kata Mas Dapur: <em>&ldquo;Naskah beres, desain tinggal gas.&rdquo;</em>
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#racik"
              class="border-2 border-[var(--ink)] bg-[var(--blue)] px-6 py-3 font-bold text-[var(--ink)] shadow-[6px_6px_0_var(--ink)] transition-all duration-150 hover:-translate-y-1 hover:shadow-[8px_8px_0_var(--ink)] active:translate-y-0 active:shadow-none"
            >
              Racik naskah sekarang
            </a>
            <a
              href="#jalur"
              class="border-2 border-[var(--ink)] bg-[var(--cream)] px-6 py-3 font-bold transition-all duration-150 hover:-translate-y-1 active:translate-y-0"
            >
              Intip jalur saji
            </a>
          </div>
          <div class="mt-10 flex flex-wrap items-center gap-4" aria-label="Label kaset">
            <span class="sticker">SIDE A &middot; GENERATOR</span>
            <span class="sticker sticker-blue">SIDE B &middot; SYARAT + EKSPOR</span>
            <span class="sticker sticker-pop">TANPA AKUN &middot; GRATIS</span>
          </div>
        </div>

        <div class="marquee-band border-t-[3px] border-[var(--ink)] bg-[var(--blue)] text-[var(--ink)]" aria-hidden="true">
          <div class="marquee-track" data-dir="-1">
            <span>12 TEMA SIAP PAKAI &#10033; 6 BLOK NASKAH &#10033; 8 SYARAT JURI &#10033; EKSPOR 1 KLIK &#10033;&nbsp;</span>
            <span>12 TEMA SIAP PAKAI &#10033; 6 BLOK NASKAH &#10033; 8 SYARAT JURI &#10033; EKSPOR 1 KLIK &#10033;&nbsp;</span>
          </div>
        </div>
      </div>
      <div class="absolute bottom-4 right-4 z-10">
        <button
          id="marquee-pause"
          type="button"
          aria-pressed="false"
          aria-label="Jeda atau jalankan teks berjalan"
          class="border-2 border-[var(--ink)] bg-[var(--bg)] px-3 py-2 text-[1rem]"
        >
          <Icon name="bi:pause-fill" class="inline h-5 w-5" aria-hidden="true" /> <span id="marquee-pause-label">Jeda</span>
        </button>
      </div>
    </section>

    <!-- ============ SIDE A: RACIK ============ -->
    <section id="racik" aria-labelledby="racik-title" class="border-b-[3px] border-[var(--ink)] bg-[var(--surface)]">
      <div class="mx-auto max-w-7xl px-4 py-16">
        <p class="sticker mb-6">SIDE A</p>
        <h2 id="racik-title" class="section-title">RACIK NASKAH</h2>
        <p class="mt-6 max-w-[62ch]">
          Pilih tema di bawah &mdash; atau ketik temamu sendiri &mdash; lalu tekan
          <strong>Racik!</strong> Dapur akan menyajikan 6 blok naskah ke jalur saji.
          Angka bertanda <strong>[contoh]</strong> wajib kamu ganti dengan hasil risetmu sendiri.
        </p>

        <form id="racik-form" class="mt-10 border-[3px] border-[var(--ink)] bg-[var(--bg)] p-5 shadow-[8px_8px_0_var(--ink)] md:p-8" novalidate>
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="nama-lomba" class="mb-2 block font-bold">Nama lomba <span class="font-normal">(opsional)</span></label>
              <input
                id="nama-lomba"
                name="nama-lomba"
                type="text"
                maxlength="120"
                autocomplete="off"
                placeholder="mis. Lomba Infografis Dies Natalis"
                class="w-full border-2 border-[var(--ink)] bg-[var(--cream)] px-4 py-3 text-[1rem]"
              />
            </div>
            <div>
              <label for="tema-input" class="mb-2 block font-bold">Tema infografis <span aria-hidden="true" class="text-[var(--blue-deep)]">*</span></label>
              <input
                id="tema-input"
                name="tema"
                type="text"
                maxlength="120"
                autocomplete="off"
                list="tema-list"
                required
                aria-required="true"
                aria-describedby="tema-error tema-hint"
                placeholder="mis. Sampah Plastik"
                class="w-full border-2 border-[var(--ink)] bg-[var(--cream)] px-4 py-3 text-[1rem]"
              />
              <datalist id="tema-list">
                {PRESETS.map((p) => <option value={p.nama}></option>)}
              </datalist>
              <p id="tema-hint" class="mt-2">Boleh pilih dari 12 tema di bawah, atau ketik bebas.</p>
            </div>
          </div>

          <fieldset class="mt-8">
            <legend class="mb-3 font-bold">Lempar salah satu lauk andalan dapur <span class="font-normal">(geser / flick)</span></legend>
            <div
              id="preset-strip"
              class="flick-strip -mx-1 flex gap-4 overflow-x-auto px-1 pb-4"
              role="listbox"
              aria-label="12 tema siap pakai"
              tabindex="0"
            >
              {PRESETS.map((p) => (
                <button
                  type="button"
                  role="option"
                  aria-selected="false"
                  data-preset={p.id}
                  class="preset-card w-52 shrink-0 cursor-grab border-[3px] border-[var(--ink)] bg-[var(--cream)] p-4 text-left transition-transform duration-150 hover:-translate-y-1 active:cursor-grabbing"
                >
                  <span class="mb-2 inline-block border-2 border-[var(--ink)] bg-[var(--blue)] px-2 py-0.5 [font-family:var(--font-accent)] text-[1rem] text-[var(--ink)]">
                    {p.nama}
                  </span>
                  <span class="block">6 blok naskah + sumber verifikasi</span>
                </button>
              ))}
            </div>
          </fieldset>

          <p id="tema-error" role="alert" class="mt-4 hidden border-2 border-[var(--ink)] bg-[var(--pop)] px-4 py-3 font-bold"></p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <button
              id="racik-btn"
              type="submit"
              class="border-2 border-[var(--ink)] bg-[var(--blue)] px-8 py-4 text-[1rem] font-bold text-[var(--ink)] shadow-[6px_6px_0_var(--ink)] transition-all duration-150 hover:-translate-y-1 hover:shadow-[8px_8px_0_var(--ink)] active:translate-y-0 active:shadow-none"
            >
              Racik!
            </button>
            <button
              id="reset-btn"
              type="button"
              class="border-2 border-[var(--ink)] bg-[var(--bg)] px-6 py-4 font-bold transition-all duration-150 hover:-translate-y-1 active:translate-y-0"
            >
              Kosongkan piring
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- ============ JALUR SAJI ============ -->
    <section id="jalur" aria-labelledby="jalur-title" class="border-b-[3px] border-[var(--ink)]">
      <div class="mx-auto max-w-7xl px-4 py-16">
        <p class="sticker sticker-blue mb-6">JALUR SAJI</p>
        <h2 id="jalur-title" class="section-title">ENAM PIRING NASKAH</h2>
        <p class="mt-6 max-w-[62ch]">
          Enam blok di bawah adalah urutan baca infografismu &mdash; dari judul sampai ajakan.
          Klik <strong>Racik!</strong> untuk mengisi otomatis, atau tulis manual. Semua tersimpan
          otomatis di browser ini.
        </p>

        <div id="spine-wrap" class="relative mt-12">
          <svg id="spine" class="pointer-events-none absolute left-[27px] top-0 hidden h-full w-[6px] md:block" aria-hidden="true">
            <line id="spine-line" x1="3" y1="0" x2="3" y2="100%" stroke="var(--ink)" stroke-width="6" stroke-dasharray="12 8" />
          </svg>
          <ol id="blok-list" class="space-y-8">
            {BLOK_LABEL.map((b, i) => (
              <li class="station relative md:pl-20" data-blok={b.id}>
                <span
                  aria-hidden="true"
                  class="station-num absolute left-0 top-0 hidden h-14 w-14 items-center justify-center border-[3px] border-[var(--ink)] bg-[var(--blue)] [font-family:var(--font-accent)] text-[1rem] text-[var(--ink)] md:flex"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <article class="border-[3px] border-[var(--ink)] bg-[var(--surface)] p-5 shadow-[6px_6px_0_var(--ink)] md:p-6">
                  <div class="mb-3 flex flex-wrap items-baseline gap-3">
                    <span class="border-2 border-[var(--ink)] bg-[var(--ink)] px-2 py-0.5 [font-family:var(--font-accent)] text-[1rem] text-[var(--bg)]">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="[font-family:var(--font-accent)] text-[1rem]">{b.nama}</h3>
                    <span class="blok-count ml-auto" aria-live="polite">0 kata</span>
                  </div>
                  <label class="sr-only" for={`blok-${b.id}`}>{`Isi blok ${b.nama}`}</label>
                  <textarea
                    id={`blok-${b.id}`}
                    data-blok-input={b.id}
                    rows="3"
                    maxlength="2000"
                    placeholder="Piringnya masih kosong. Pilih tema di atas biar dapur ngebul."
                    class="blok-input w-full resize-y border-2 border-[var(--ink)] bg-[var(--cream)] px-4 py-3 text-[1rem] leading-relaxed"
                  ></textarea>
                  <p class="mt-3 flex gap-2">
                    <Icon name="bi:lightbulb" class="mt-1 h-5 w-5 shrink-0" aria-hidden="true" />
                    <span><strong>Tips Mas Dapur:</strong> {b.tip}</span>
                  </p>
                </article>
              </li>
            ))}
          </ol>
        </div>
        <p class="mt-8 border-2 border-dashed border-[var(--ink)] p-4">
          <Icon name="bi:exclamation-triangle" class="mr-2 inline h-5 w-5" aria-hidden="true" />
          <strong>Aturan dapur:</strong> semua angka bertanda [contoh] wajib diganti hasil risetmu dan
          cantumkan sumbernya di kaki infografis. Naskah palsu = didiskualifikasi.
        </p>
      </div>
    </section>

    <!-- ============ TIPOGRAFI ============ -->
    <section id="tipografi" aria-labelledby="tipografi-title" class="border-b-[3px] border-[var(--ink)] bg-[var(--ink)] text-[var(--bg)]">
      <div class="mx-auto max-w-7xl px-4 py-16">
        <p class="sticker sticker-pop mb-6">PANDUAN JURI</p>
        <h2 id="tipografi-title" class="section-title text-[var(--bg)]">TIGA ATURAN HURUF</h2>
        <p class="mt-6 max-w-[62ch]">
          Kata Mas Dapur: <em>&ldquo;Desain boleh heboh, huruf jangan ikut-ikutan heboh.&rdquo;</em>
          Tiga aturan ini yang paling sering menggugurkan peserta di meja juri.
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {TIPOGRAFI.map((t, i) => (
            <article class="border-[3px] border-[var(--bg)] bg-transparent p-6">
              <span aria-hidden="true" class="mb-4 inline-block bg-[var(--pop)] px-3 py-1 [font-family:var(--font-accent)] text-[1rem] text-[var(--ink)]">
                ATURAN {i + 1}
              </span>
              <h3 class="[font-family:var(--font-accent)] text-[1rem]">{t.nama}</h3>
              <p class="mt-3">{t.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SIDE B: SYARAT ============ -->
    <section id="syarat" aria-labelledby="syarat-title" class="border-b-[3px] border-[var(--ink)] bg-[var(--surface)]">
      <div class="mx-auto max-w-7xl px-4 py-16">
        <p class="sticker sticker-blue mb-6">SIDE B</p>
        <h2 id="syarat-title" class="section-title">SYARAT JURI</h2>
        <p class="mt-6 max-w-[62ch]">
          Delapan syarat administratif yang paling sering bikin peserta gugur.
          Centang satu per satu &mdash; progresmu tersimpan otomatis.
        </p>

        <div class="mt-8 border-[3px] border-[var(--ink)] bg-[var(--bg)] p-5">
          <div class="mb-2 flex items-center justify-between">
            <span class="font-bold">Progres dapur</span>
            <span id="syarat-count" aria-live="polite" class="[font-family:var(--font-accent)]">0/8 beres</span>
          </div>
          <div
            class="h-6 border-2 border-[var(--ink)] bg-[var(--cream)]"
            role="progressbar"
            aria-label="Progres checklist syarat"
            aria-valuemin="0"
            aria-valuemax="8"
            aria-valuenow="0"
            id="syarat-progress"
          >
            <div id="syarat-bar" class="h-full w-0 bg-[var(--blue)] transition-[width] duration-300"></div>
          </div>
          <p id="syarat-msg" class="mt-3" aria-live="polite"></p>
        </div>

        <ul class="mt-8 grid gap-5 md:grid-cols-2">
          {SYARAT.map((s) => (
            <li>
              <label class="syarat-card flex cursor-pointer gap-4 border-[3px] border-[var(--ink)] bg-[var(--bg)] p-5 transition-transform duration-150 hover:-translate-y-1">
                <input type="checkbox" data-syarat={s.id} class="h-11 w-11 shrink-0 accent-[#2b2bd9]" />
                <span>
                  <span class="block font-bold">{s.nama}</span>
                  <span class="mt-1 block">{s.detail}</span>
                </span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ EKSPOR ============ -->
    <section id="ekspor" aria-labelledby="ekspor-title" class="border-b-[3px] border-[var(--ink)]">
      <div class="mx-auto max-w-7xl px-4 py-16">
        <p class="sticker mb-6">BUNGKUS</p>
        <h2 id="ekspor-title" class="section-title">BAWA PULANG</h2>
        <p class="mt-6 max-w-[62ch]">
          Naskahmu tersimpan otomatis di browser ini (<em>localStorage</em> &mdash; tidak dikirim ke
          mana pun). Bungkus untuk dibawa ke aplikasi desain atau dibagikan ke tim.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <button id="btn-salin" type="button" class="btn-bungkus">
            <Icon name="bi:clipboard" class="h-5 w-5" aria-hidden="true" /> Salin semua
          </button>
          <button id="btn-unduh" type="button" class="btn-bungkus">
            <Icon name="bi:download" class="h-5 w-5" aria-hidden="true" /> Unduh .md
          </button>
          <button id="btn-cetak" type="button" class="btn-bungkus">
            <Icon name="bi:printer" class="h-5 w-5" aria-hidden="true" /> Cetak
          </button>
          <button id="btn-tautan" type="button" class="btn-bungkus">
            <Icon name="bi:link-45deg" class="h-5 w-5" aria-hidden="true" /> Salin tautan naskah
          </button>
        </div>
        <p id="ekspor-msg" class="mt-4 font-bold" role="status" aria-live="polite"></p>
        <p class="mt-4 max-w-[62ch]">
          <Icon name="bi:info-circle" class="mr-2 inline h-5 w-5" aria-hidden="true" />
          Tautan naskah berisi seluruh teks naskahmu di dalam URL &mdash; praktis untuk dibuka di HP,
          tapi jangan disebar ke publik sebelum lomba selesai.
        </p>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <FAQs
      id="faq"
      title="TANYA MAS DAPUR"
      subtitle="Yang sering ditanyakan sebelum meracik."
      items={faqItems}
      schema={true}
      classes={{ container: 'max-w-4xl' }}
    />
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="border-t-[3px] border-[var(--ink)] bg-[var(--ink)] text-[var(--bg)]">
    <div class="mx-auto max-w-7xl px-4 py-12">
      <p class="[font-family:var(--font-display)] leading-none">SELAMAT<br />MEMASAK.</p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
        <a class="footerlink" href="#racik">Racik</a>
        <a class="footerlink" href="#jalur">Jalur Saji</a>
        <a class="footerlink" href="#tipografi">Tipografi</a>
        <a class="footerlink" href="#syarat">Syarat</a>
        <a class="footerlink" href="#ekspor">Ekspor</a>
        <a class="footerlink" href="#faq">FAQ</a>
      </div>
      <p class="mt-8 max-w-[62ch]">
        InfografisCepat &mdash; dapur naskah lomba infografis. Naskah tersimpan lokal di browser kamu,
        tidak dikirim ke mana pun. Angka bertanda [contoh] wajib diganti hasil risetmu.
      </p>
      <p class="mt-4 flex items-center gap-2">
        <span aria-hidden="true" class="inline-block h-4 w-4 bg-[var(--pop)]"></span>
        Dibuat dengan teliti, disajikan hangat.
      </p>
    </div>
  </footer>

  <div id="live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <div id="easter" class="fixed bottom-6 left-1/2 z-[70] hidden -translate-x-1/2 border-[3px] border-[var(--ink)] bg-[var(--pop)] px-6 py-4 shadow-[6px_6px_0_var(--ink)]" role="status">
    <p class="[font-family:var(--font-accent)]">SIDE C TERBUKA!</p>
    <p>Kembalian receh, naskah mewah. &mdash; Mas Dapur</p>
  </div>

  <style is:global>
    /* Keputusan berani: hanya dua ukuran — 1rem dan raksasa */
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 9vw, 8rem);
      line-height: 0.95;
      letter-spacing: -0.02em;
    }
    #hero-title {
      font-size: clamp(3.5rem, 16vw, 15rem);
    }
    .navlink, .footerlink {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
    .footerlink { color: var(--bg); }
    .sticker {
      display: inline-block;
      border: 2px solid var(--ink);
      background: var(--cream);
      color: var(--ink);
      padding: 0.25rem 0.75rem;
      font-family: var(--font-accent);
      font-size: 1rem;
      box-shadow: 3px 3px 0 var(--ink);
      transform: rotate(-1.5deg);
    }
    .sticker-blue { background: var(--blue); }
    .sticker-pop { background: var(--pop); transform: rotate(1.5deg); }
    .btn-bungkus {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 2px solid var(--ink);
      background: var(--cream);
      padding: 0.9rem 1.4rem;
      font-size: 1rem;
      font-weight: 700;
      box-shadow: 4px 4px 0 var(--ink);
      transition: transform 150ms var(--ease-standard), box-shadow 150ms var(--ease-standard);
    }
    .btn-bungkus:hover { transform: translateY(-2px); box-shadow: 6px 6px 0 var(--ink); }
    .btn-bungkus:active { transform: translateY(0); box-shadow: none; }
    .syarat-card input { min-width: 24px; min-height: 24px; }
    .syarat-card:has(input:checked) { background: var(--pop); }
    .syarat-card:has(input:focus-visible) { outline: 3px solid var(--blue-deep); outline-offset: 3px; }

    /* Marquee B: 2 band berlawanan */
    .marquee-band { overflow: hidden; white-space: nowrap; }
    .marquee-track {
      display: inline-flex;
      font-family: var(--font-accent);
      font-size: 1rem;
      padding: 0.6rem 0;
      animation: marquee 22s linear infinite;
      will-change: transform;
    }
    .marquee-track[data-dir="-1"] { animation-direction: reverse; }
    @keyframes marquee {
      from { transform: translateX(0) skewX(0); }
      to { transform: translateX(-50%) skewX(0); }
    }
    .marquee-track.skewing { animation-duration: 8s; }

    /* fieldset butuh min-width:0 agar strip tidak melebar (bug klasik) */
    #racik-form fieldset { min-width: 0; }

    /* Flick strip D */
    .flick-strip {
      cursor: grab;
      scrollbar-width: thin;
      touch-action: pan-y;
    }
    .flick-strip.dragging { cursor: grabbing; }
    .flick-strip.dragging .preset-card { user-select: none; }
    .preset-card[aria-selected="true"] {
      background: var(--pop);
      transform: translateY(-4px);
      box-shadow: 4px 4px 0 var(--ink);
    }

    /* Station reveal (hanya kalau JS jalan) */
    html.js .station { opacity: 0; transform: translateY(24px); }
    .station.filled .station-num { background: var(--pop); }
    .station.in { opacity: 1; transform: none; transition: opacity 500ms var(--ease-out-expo), transform 500ms var(--ease-out-expo); }

    .blok-input { font-size: 1rem; }
    input, textarea, select { font-size: 16px; } /* cegah zoom iOS */

    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none; }
      .station { opacity: 1; transform: none; }
    }
    [data-motion="off"] .marquee-track { animation: none; }
    [data-motion="off"] .station { opacity: 1 !important; transform: none !important; transition: none !important; }

    /* Print: hanya naskah + checklist */
    @media print {
      header, #top, #racik, #tipografi, #ekspor, #faq, footer, #easter, .marquee-band { display: none !important; }
      body::before { display: none; }
      .station { opacity: 1 !important; transform: none !important; }
    }
  </style>

  <script>
    import '../scripts/dapur.js';
  </script>
</Layout>
